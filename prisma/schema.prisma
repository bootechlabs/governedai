// GovernedAI MVP data model — see docs/mvp-scope.md for the pillar this backs
// (inventory / workflow / evidence) and the field rationale.
//
// Identity, organizations, sessions, and SSO are owned by Stytch B2B, not
// this database — see src/lib/stytch.ts. Organization.id and User.id are
// Stytch's organization_id / member_id verbatim (not generated cuids), so
// there's exactly one ID system instead of two that could drift. This
// schema only mirrors the fields needed for fast local joins/display
// (names, roles, audit trail) — Stytch stays authoritative for auth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  REVIEWER
  CONTRIBUTOR
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DeploymentStatus {
  PLANNED
  PILOT
  PRODUCTION
  RETIRED
}

enum StageStatus {
  PENDING
  IN_REVIEW
  APPROVED
  CONDITIONALLY_APPROVED
  REJECTED
}

enum EvidenceType {
  FILE
  LINK
}

enum UseCaseTemplate {
  AMBIENT_SCRIBE
  CLINICAL_DECISION_SUPPORT
  PRIOR_AUTH_UM
  RCM_BILLING
  PATIENT_CHATBOT
  GENERIC
}

enum RiskTier {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum Regulation {
  NIST_AI_RMF
  EU_AI_ACT
  ISO_42001
  NYC_LL144
  CO_SB21_169
}

enum BaaStatus {
  NOT_APPLICABLE
  REQUIRED_NOT_ON_FILE
  ON_FILE
  EXPIRED
}

enum EvidenceCategory {
  GENERAL
  BAA
  SOC2_REPORT
  MODEL_CARD
  BIAS_AUDIT_REPORT
  TEST_RESULT
  APPROVAL_RECORD
  POLICY_DOCUMENT
  SUBPROCESSOR_LIST
  OTHER
}

// Mirrors a Stytch B2B Organization. id = Stytch's organization_id.
model Organization {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  users     User[]
  aiSystems AiSystem[]
  apiKeys   ApiKey[]
  vendors   Vendor[]
}

// Admin-managed vendor registry — additive to AiSystem.vendorName (free
// text, still what bulk import/API/quick-add write), not a replacement.
// A system auto-links to a Vendor when its vendorName exactly matches
// one in the org (see src/lib/ai-systems.ts matchVendorByName), so
// nothing already shipped had to change to benefit from this.
model Vendor {
  id            String    @id @default(cuid())
  name          String
  baaStatus     BaaStatus @default(REQUIRED_NOT_ON_FILE)
  subprocessors String[]
  soc2ReportUrl String?
  modelCardUrl  String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  aiSystems AiSystem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Mirrors a Stytch B2B Member. id = Stytch's member_id. Role is local-only
// (Stytch doesn't need to know our app-specific RBAC) — set via the admin
// "Manage users" page, read synchronously by src/lib/permissions.ts.
model User {
  id             String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String?
  email          String
  role           UserRole     @default(CONTRIBUTOR)
  createdAt      DateTime     @default(now())

  ownedSystems     AiSystem[]      @relation("SystemOwner")
  ownedStages      WorkflowStage[] @relation("StageOwner")
  uploadedEvidence EvidenceItem[]  @relation("EvidenceUploader")
  auditEntries     AuditLogEntry[] @relation("AuditActor")
  createdApiKeys   ApiKey[]        @relation("ApiKeyCreator")
  riskClassificationsCompleted RiskClassification[] @relation("RiskClassificationCompleter")

  @@unique([organizationId, email])
}

model AiSystem {
  id               String             @id @default(cuid())
  name             String
  description      String?
  businessUnit     String?
  vendorName       String?
  classification   DataClassification @default(INTERNAL)
  vendor           Vendor?            @relation(fields: [vendorId], references: [id])
  vendorId         String?
  deploymentStatus DeploymentStatus   @default(PLANNED)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  archivedAt       DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  owner   User   @relation("SystemOwner", fields: [ownerId], references: [id])
  ownerId String

  stages             WorkflowStage[]
  evidence           EvidenceItem[]
  auditLog           AuditLogEntry[]
  riskClassification RiskClassification?

  @@index([organizationId])
}

// Produced by the intake questionnaire (src/lib/risk-classification.ts) —
// one current classification per system, not versioned; retaking it
// overwrites this row, with history preserved via a "risk_classified"
// AuditLogEntry on every run (same pattern as every other mutation).
model RiskClassification {
  id                   String           @id @default(cuid())
  useCaseTemplate      UseCaseTemplate
  answers              Json
  riskTier             RiskTier
  triggeredRegulations Regulation[]
  completedAt          DateTime         @default(now())

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String   @unique

  completedBy   User   @relation("RiskClassificationCompleter", fields: [completedById], references: [id])
  completedById String
}

// Fixed MVP stage sequence (see mvp-scope.md): Intake -> Risk Review -> decision.
// `stageName` and `sequence` are data, not schema, so relabeling doesn't need a migration.
model WorkflowStage {
  id                String      @id @default(cuid())
  stageName         String
  sequence          Int
  status            StageStatus @default(PENDING)
  decisionRationale String?
  decidedAt         DateTime?

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String

  owner   User?   @relation("StageOwner", fields: [ownerId], references: [id])
  ownerId String?

  evidence EvidenceItem[]

  @@unique([aiSystemId, sequence])
}

model EvidenceItem {
  id       String           @id @default(cuid())
  type     EvidenceType
  category EvidenceCategory @default(GENERAL)
  fileUrl  String?
  linkUrl  String?
  label    String?

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String

  workflowStage   WorkflowStage? @relation(fields: [workflowStageId], references: [id])
  workflowStageId String?

  uploadedBy   User   @relation("EvidenceUploader", fields: [uploadedById], references: [id])
  uploadedById String

  uploadedAt DateTime @default(now())
}

// The public API (see src/app/api/v1) authenticates with one of these per
// org, admin-generated. Only a sha256 hash is stored — the plaintext key
// is shown once at creation and never persisted, same as a password.
model ApiKey {
  id        String   @id @default(cuid())
  name      String
  keyPrefix String
  keyHash   String   @unique
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdBy   User   @relation("ApiKeyCreator", fields: [createdById], references: [id])
  createdById String

  @@index([organizationId])
}

// Immutable by convention: application code must only insert, never update/delete rows here.
model AuditLogEntry {
  id         String   @id @default(cuid())
  action     String
  detail     Json?
  occurredAt DateTime @default(now())

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String

  actor   User   @relation("AuditActor", fields: [actorId], references: [id])
  actorId String
}
