// GovernedAI MVP data model — see docs/mvp-scope.md for the pillar this backs
// (inventory / workflow / evidence) and the field rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  REVIEWER
  CONTRIBUTOR
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DeploymentStatus {
  PLANNED
  PILOT
  PRODUCTION
  RETIRED
}

enum StageStatus {
  PENDING
  IN_REVIEW
  APPROVED
  CONDITIONALLY_APPROVED
  REJECTED
}

enum EvidenceType {
  FILE
  LINK
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CONTRIBUTOR)
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  ownedSystems     AiSystem[]      @relation("SystemOwner")
  ownedStages      WorkflowStage[] @relation("StageOwner")
  uploadedEvidence EvidenceItem[]  @relation("EvidenceUploader")
  auditEntries     AuditLogEntry[] @relation("AuditActor")
}

// Auth.js (NextAuth) PrismaAdapter — required shape, see https://authjs.dev/getting-started/adapters/prisma
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AiSystem {
  id               String             @id @default(cuid())
  name             String
  description      String?
  businessUnit     String?
  vendorName       String?
  classification   DataClassification @default(INTERNAL)
  deploymentStatus DeploymentStatus   @default(PLANNED)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  archivedAt       DateTime?

  owner   User   @relation("SystemOwner", fields: [ownerId], references: [id])
  ownerId String

  stages   WorkflowStage[]
  evidence EvidenceItem[]
  auditLog AuditLogEntry[]
}

// Fixed MVP stage sequence (see mvp-scope.md): Intake -> Risk Review -> decision.
// `stageName` and `sequence` are data, not schema, so relabeling doesn't need a migration.
model WorkflowStage {
  id                String      @id @default(cuid())
  stageName         String
  sequence          Int
  status            StageStatus @default(PENDING)
  decisionRationale String?
  decidedAt         DateTime?

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String

  owner   User?   @relation("StageOwner", fields: [ownerId], references: [id])
  ownerId String?

  evidence EvidenceItem[]

  @@unique([aiSystemId, sequence])
}

model EvidenceItem {
  id      String       @id @default(cuid())
  type    EvidenceType
  fileUrl String?
  linkUrl String?
  label   String?

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String

  workflowStage   WorkflowStage? @relation(fields: [workflowStageId], references: [id])
  workflowStageId String?

  uploadedBy   User   @relation("EvidenceUploader", fields: [uploadedById], references: [id])
  uploadedById String

  uploadedAt DateTime @default(now())
}

// Immutable by convention: application code must only insert, never update/delete rows here.
model AuditLogEntry {
  id         String   @id @default(cuid())
  action     String
  detail     Json?
  occurredAt DateTime @default(now())

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String

  actor   User   @relation("AuditActor", fields: [actorId], references: [id])
  actorId String
}
