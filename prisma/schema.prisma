// GovernedAI MVP data model — see docs/mvp-scope.md for the pillar this backs
// (inventory / workflow / evidence) and the field rationale.
//
// Identity, organizations, sessions, and SSO are owned by Stytch B2B, not
// this database — see src/lib/stytch.ts. Organization.id and User.id are
// Stytch's organization_id / member_id verbatim (not generated cuids), so
// there's exactly one ID system instead of two that could drift. This
// schema only mirrors the fields needed for fast local joins/display
// (names, roles, audit trail) — Stytch stays authoritative for auth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  REVIEWER
  CONTRIBUTOR
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DeploymentStatus {
  PLANNED
  PILOT
  PRODUCTION
  RETIRED
}

enum StageStatus {
  PENDING
  IN_REVIEW
  APPROVED
  CONDITIONALLY_APPROVED
  REJECTED
}

enum EvidenceType {
  FILE
  LINK
}

enum UseCaseTemplate {
  AMBIENT_SCRIBE
  CLINICAL_DECISION_SUPPORT
  PRIOR_AUTH_UM
  RCM_BILLING
  PATIENT_CHATBOT
  GENERIC
}

enum RiskTier {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum Regulation {
  NIST_AI_RMF
  EU_AI_ACT
  ISO_42001
  NYC_LL144
  CO_SB21_169
}

enum BaaStatus {
  NOT_APPLICABLE
  REQUIRED_NOT_ON_FILE
  ON_FILE
  EXPIRED
}

enum EvidenceCategory {
  GENERAL
  BAA
  SOC2_REPORT
  MODEL_CARD
  BIAS_AUDIT_REPORT
  TEST_RESULT
  APPROVAL_RECORD
  POLICY_DOCUMENT
  SUBPROCESSOR_LIST
  OTHER
}

// Mirrors a Stytch B2B Organization. id = Stytch's organization_id.
model Organization {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  vertical  String?

  users     User[]
  aiSystems AiSystem[]
  apiKeys   ApiKey[]
  vendors   Vendor[]
}

// Admin-managed vendor registry — additive to AiSystem.vendorName (free
// text, still what bulk import/API/quick-add write), not a replacement.
// A system auto-links to a Vendor when its vendorName exactly matches
// one in the org (see src/lib/ai-systems.ts matchVendorByName), so
// nothing already shipped had to change to benefit from this.
model Vendor {
  id            String    @id @default(cuid())
  name          String
  baaStatus     BaaStatus @default(REQUIRED_NOT_ON_FILE)
  subprocessors String[]
  soc2ReportUrl String?
  modelCardUrl  String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  aiSystems AiSystem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Mirrors a Stytch B2B Member. id = Stytch's member_id. Role is local-only
// (Stytch doesn't need to know our app-specific RBAC) — set via the admin
// "Manage users" page, read synchronously by src/lib/permissions.ts.
model User {
  id             String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String?
  email          String
  avatarUrl      String?
  role           UserRole     @default(CONTRIBUTOR)
  // Orthogonal to `role` — a handful of Bootech staff, not an org-scoped
  // permission. Grants access to /platform (see src/app/platform) and the
  // ability to impersonate any non-platform-admin user. Set directly via
  // prisma/seed.ts or a manual DB update; no in-app UI grants this.
  isPlatformAdmin Boolean     @default(false)
  createdAt      DateTime     @default(now())

  ownedSystems     AiSystem[]      @relation("SystemOwner")
  ownedStages      WorkflowStage[] @relation("StageOwner")
  uploadedEvidence EvidenceItem[]  @relation("EvidenceUploader")
  auditEntries     AuditLogEntry[] @relation("AuditActor")
  createdApiKeys   ApiKey[]        @relation("ApiKeyCreator")
  riskClassificationsCompleted RiskClassification[] @relation("RiskClassificationCompleter")
  impersonationsInitiated ImpersonationSession[] @relation("ImpersonationInitiator")
  impersonationsReceived  ImpersonationSession[] @relation("ImpersonationTarget")
  changeEventsRecorded    ChangeEvent[]          @relation("ChangeEventActor")
  shareLinksCreated       ShareLink[]            @relation("ShareLinkCreator")

  @@unique([organizationId, email])
}

// One row per impersonation session, time-boxed via expiresAt; endedAt is
// set explicitly on stop. src/lib/current-user.ts checks both before
// honoring one — see src/lib/impersonation.ts for the create/read/end
// helpers. Never updated except to set endedAt (audit trail of every
// impersonation lives here plus the impersonation_started/ended
// AuditLogEntry rows).
model ImpersonationSession {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  expiresAt  DateTime
  endedAt    DateTime?

  platformAdmin   User @relation("ImpersonationInitiator", fields: [platformAdminId], references: [id])
  platformAdminId String

  targetUser   User @relation("ImpersonationTarget", fields: [targetUserId], references: [id])
  targetUserId String

  @@index([platformAdminId])
  @@index([targetUserId])
}

model AiSystem {
  id               String             @id @default(cuid())
  name             String
  description      String?
  businessUnit     String?
  vendorName       String?
  classification   DataClassification @default(INTERNAL)
  vendor           Vendor?            @relation(fields: [vendorId], references: [id])
  vendorId         String?
  deploymentStatus DeploymentStatus   @default(PLANNED)
  // 2-letter US state codes where this system is actually deployed/used —
  // drives STATE_DEPLOYMENT regulation triggers (see RegulationDefinition).
  // Edit-form-only, same as description (not in the compact inventory
  // quick-add row).
  statesDeployed   String[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  archivedAt       DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  owner   User   @relation("SystemOwner", fields: [ownerId], references: [id])
  ownerId String

  stages             WorkflowStage[]
  evidence           EvidenceItem[]
  auditLog           AuditLogEntry[]
  riskClassification RiskClassification?
  changeEvents       ChangeEvent[]
  shareLinks         ShareLink[]

  @@index([organizationId])
}

// One row per key-field change (see src/lib/change-events.ts for which
// fields count) — immutable, like AuditLogEntry. Recertification need is
// computed from these against WorkflowStage.decidedAt, not a stored flag
// — see src/lib/workflow.ts needsRecertification.
model ChangeEvent {
  id          String   @id @default(cuid())
  field       String
  beforeValue String?
  afterValue  String?
  occurredAt  DateTime @default(now())

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String

  actor   User   @relation("ChangeEventActor", fields: [actorId], references: [id])
  actorId String

  @@index([aiSystemId])
}

// Token-based, time-boxed, revocable read-only link for handing a
// system's governance report to an external auditor — see
// src/lib/share-links.ts. Only tokenHash is stored (sha256 of the
// plaintext, shown once at creation) — same pattern as ApiKey.keyHash.
// Anonymous views are tracked via ShareLinkView, not AuditLogEntry:
// AuditLogEntry.actorId is NOT NULL and every other write-path assumes
// an authenticated actor, so an anonymous view gets its own table
// rather than loosening that system-wide invariant.
model ShareLink {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  tokenPrefix String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String

  createdBy   User   @relation("ShareLinkCreator", fields: [createdById], references: [id])
  createdById String

  views ShareLinkView[]

  @@index([aiSystemId])
}

model ShareLinkView {
  id       String   @id @default(cuid())
  viewedAt DateTime @default(now())
  viewerIp String?

  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  shareLinkId String

  @@index([shareLinkId])
}

// Produced by the intake questionnaire (src/lib/risk-classification.ts) —
// one current classification per system, not versioned; retaking it
// overwrites this row, with history preserved via a "risk_classified"
// AuditLogEntry on every run (same pattern as every other mutation).
model RiskClassification {
  id              String          @id @default(cuid())
  useCaseTemplate UseCaseTemplate
  answers         Json
  riskTier        RiskTier
  // Deprecated as of the dynamic regulation engine (see RegulationDefinition
  // below) — left in place, unused by app code, as a one-release safety net
  // against a backfill mistake rather than dropped immediately.
  triggeredRegulations Regulation[]
  completedAt          DateTime     @default(now())

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String   @unique

  completedBy   User   @relation("RiskClassificationCompleter", fields: [completedById], references: [id])
  completedById String

  triggeredRegulationRows RiskClassificationRegulation[]
}

// Replaces the old fixed `Regulation` enum as the source of truth for what
// can be triggered — a regulation is a data row, not a code change, so a
// new state law is a seed insert, not a migration + deploy. `code` mirrors
// the legacy enum member names for the first 5 (NIST_AI_RMF, EU_AI_ACT,
// ISO_42001, NYC_LL144, CO_SB21_169) so existing AuditLogEntry.detail JSON
// referencing those strings stays readable. `triggerConfig` is a small
// closed discriminated union interpreted by
// src/lib/risk-classification.ts's computeRiskClassification — see that
// file for the exact shapes (TIER_AT_LEAST / QUESTION_WEIGHT_AT_LEAST /
// STATE_DEPLOYMENT).
model RegulationDefinition {
  id            String    @id @default(cuid())
  code          String    @unique
  label         String
  citation      String?
  summary       String?
  sourceUrl     String?
  effectiveDate DateTime?
  triggerConfig Json
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)

  artifacts   RegulationArtifactDefinition[]
  triggeredIn RiskClassificationRegulation[]
}

// The compliance-checklist items shown for a regulation once triggered —
// replaces the per-regulation artifact list that used to live in the
// REGULATION_SECTIONS static map in src/lib/regulation-sections.ts.
// "onFile" status is still computed generically from EvidenceItem.category,
// unchanged from before.
model RegulationArtifactDefinition {
  id               String           @id @default(cuid())
  label            String
  description      String
  evidenceCategory EvidenceCategory
  sortOrder        Int              @default(0)

  regulation   RegulationDefinition @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  regulationId String

  @@index([regulationId])
}

// Join row for "this RiskClassification triggered this regulation" —
// replaces RiskClassification.triggeredRegulations (an enum array) now
// that a regulation is a row, not an enum value.
model RiskClassificationRegulation {
  id                   String @id @default(cuid())

  riskClassification   RiskClassification @relation(fields: [riskClassificationId], references: [id], onDelete: Cascade)
  riskClassificationId String

  regulation   RegulationDefinition @relation(fields: [regulationId], references: [id])
  regulationId String

  @@unique([riskClassificationId, regulationId])
  @@index([riskClassificationId])
}

// Fixed MVP stage sequence (see mvp-scope.md): Intake -> Risk Review -> decision.
// `stageName` and `sequence` are data, not schema, so relabeling doesn't need a migration.
model WorkflowStage {
  id                String      @id @default(cuid())
  stageName         String
  sequence          Int
  status            StageStatus @default(PENDING)
  decisionRationale String?
  decidedAt         DateTime?

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String

  owner   User?   @relation("StageOwner", fields: [ownerId], references: [id])
  ownerId String?

  evidence EvidenceItem[]

  @@unique([aiSystemId, sequence])
}

model EvidenceItem {
  id       String           @id @default(cuid())
  type     EvidenceType
  category EvidenceCategory @default(GENERAL)
  fileUrl  String?
  linkUrl  String?
  label    String?

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String

  workflowStage   WorkflowStage? @relation(fields: [workflowStageId], references: [id])
  workflowStageId String?

  uploadedBy   User   @relation("EvidenceUploader", fields: [uploadedById], references: [id])
  uploadedById String

  uploadedAt DateTime @default(now())
}

// The public API (see src/app/api/v1) authenticates with one of these per
// org, admin-generated. Only a sha256 hash is stored — the plaintext key
// is shown once at creation and never persisted, same as a password.
model ApiKey {
  id        String   @id @default(cuid())
  name      String
  keyPrefix String
  keyHash   String   @unique
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdBy   User   @relation("ApiKeyCreator", fields: [createdById], references: [id])
  createdById String

  @@index([organizationId])
}

// Immutable by convention: application code must only insert, never update/delete rows here.
model AuditLogEntry {
  id         String   @id @default(cuid())
  action     String
  detail     Json?
  occurredAt DateTime @default(now())

  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  aiSystemId String

  actor   User   @relation("AuditActor", fields: [actorId], references: [id])
  actorId String
}
