# Copy to .env.local (gitignored) and fill in real values.

# Postgres connection string — Neon or Supabase free tier for MVP.
DATABASE_URL="postgresql://user:password@host:5432/governedai?sslmode=require"

# Stytch B2B — identity, organizations, sessions, and SSO. Create a B2B
# project (not Consumer) at stytch.com, use Test environment credentials
# for local dev.
STYTCH_PROJECT_ID=""
STYTCH_SECRET=""
NEXT_PUBLIC_STYTCH_PUBLIC_KEY=""
STYTCH_PROJECT_ENV="test"

# Cloudflare R2 (S3-compatible) — evidence file uploads.
# Leave all four unset to use the local-disk dev fallback
# (public/evidence-uploads/, gitignored) instead.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public base URL for the bucket (R2.dev subdomain or a custom domain).
R2_PUBLIC_URL_BASE=""

# Resend — transactional email for the impersonation-started notice only
# (Stytch remains the only channel for auth/magic-link emails). Leave both
# unset to skip sending (logged, not thrown) — useful for local dev.
RESEND_API_KEY=""
EMAIL_FROM="GovernedAI <notifications@governedai.co>"

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# triggering /api/cron/vendor-reattestation (see vercel.json). Set to any
# random string in Vercel's env vars — the cron route rejects any request
# without a matching header, since there's no user session to check.
CRON_SECRET=""
