# Copy to .env.local (gitignored) and fill in real values.

# Postgres connection string — Neon or Supabase free tier for MVP.
DATABASE_URL="postgresql://user:password@host:5432/governedai?sslmode=require"

# Stytch B2B — identity, organizations, sessions, and SSO. Create a B2B
# project (not Consumer) at stytch.com, use Test environment credentials
# for local dev.
STYTCH_PROJECT_ID=""
STYTCH_SECRET=""
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=""
STYTCH_PROJECT_ENV="test"

# Cloudflare R2 (S3-compatible) — evidence file uploads.
# Leave all four unset to use the local-disk dev fallback
# (public/evidence-uploads/, gitignored) instead.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public base URL for the bucket (R2.dev subdomain or a custom domain).
R2_PUBLIC_URL_BASE=""
